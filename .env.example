# ==========================================================
#  LELWAK STARS CBO — ENVIRONMENT VARIABLES
#  Copy this file to `.env.local` and fill in the values.
#  `.env.local` is git-ignored — never commit real keys.
# ==========================================================

# ---- Supabase: safe to expose (anon / publishable key) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Supabase: SERVER ONLY — never prefix with NEXT_PUBLIC_ ----
# Only needed for the admin dashboard + partner notifications.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Supabase Storage ----
# Public bucket that holds the optimised website images.
SUPABASE_STORAGE_BUCKET=gallery

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional: notify the team when a partner enquiry lands ----
# A Supabase Edge Function or Resend/Nodemailer key. Left empty for now.
PARTNER_ALERT_EMAIL=
